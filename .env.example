# Copy to .env (gitignored) and fill in. Loaded by src/kl/config.py at start if the variable is not already set.
# Never commit .env. The key is never logged or written to a transcript.

# Anthropic API key for kl-annotate, the LLM half of kl-update, and kl-agent. Leave empty to run deterministic-only.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown).
# KL_MODEL=claude-opus-5-5              the agent
# KL_ANNOTATE_MODEL=claude-sonnet-5-5   per-document grounded annotation
# KL_ANNOTATE_MIN_CONFIDENCE=0.5         a chosen or added mention enters about_* at or above this confidence
# KL_AS_OF=2026-10-27
# KL_PG_DB=corvana_kl
# KL_PG_ADMIN=postgres
# PGHOST=localhost
# PGPORT=5432
# PGPASSWORD=
